# ---- Supabase ----
# 肉体副業のテーブルは supabase/migrations/0002_nikutai_fukugyou.sql
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# 運用スクリプトと /admin が使う。RLS を bypass するのでブラウザに渡さないこと
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- 管理画面 (docs/02_DECISIONS.md D-015) ----
# /admin に入るための共有トークン。十分に長いランダム文字列にすること
ADMIN_TOKEN=""

# ---- 公開 URL ----
# X 投稿候補のリンク生成に使う
NEXT_PUBLIC_SITE_URL="https://example.com"

# ---- 巡回 ----
# User-Agent に載せる連絡先。誰が取得しているか分かるようにする
CRAWLER_CONTACT="https://example.com/about"
