# ============================================================================
# 肉体副業 V0.1 — 環境変数
#
# hosting / DB は Cloudflare（Workers + D1）。無料枠の範囲で動かす。
# 詳細は docs/08_ARCHITECTURE.md
# ============================================================================

# ---- 管理画面 (docs/02_DECISIONS.md D-015) ----
# /admin に入るための共有トークン。十分に長いランダム文字列にすること
# Cloudflare 側には `wrangler secret put ADMIN_TOKEN` で登録する
ADMIN_TOKEN=""

# ---- 公開 URL ----
# sitemap と X 投稿候補のリンク生成に使う
NEXT_PUBLIC_SITE_URL="https://example.com"

# ---- 巡回 ----
# User-Agent に載せる連絡先。誰が取得しているか分かるようにする
CRAWLER_CONTACT="https://example.com/about"

# ---- 運用スクリプト用（Worker の外から D1 を触るため） ----
# Cloudflare ダッシュボードの Account ID
CLOUDFLARE_ACCOUNT_ID=""
# `wrangler d1 create nikutai-fukugyou` が出力する database_id
CLOUDFLARE_D1_DATABASE_ID=""
# D1 の編集権限だけを付けた API トークン。GitHub Actions では secret に入れる
CLOUDFLARE_API_TOKEN=""

# ---- Google AdSense (docs/09_MONETIZATION.md) ----
# パブリッシャー ID。ca-pub- で始まる値。公開値なので secret ではない
NEXT_PUBLIC_ADSENSE_CLIENT=""
# "true" のときだけ広告を配信する。production ビルドでのみ有効
# preview / staging では設定しない（production 広告の誤表示を防ぐ）
NEXT_PUBLIC_ADS_ENABLED=""
# 広告ユニットのスロット ID。設定した枠だけが表示される
NEXT_PUBLIC_ADSENSE_SLOT_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_LISTING_LIST=""
NEXT_PUBLIC_ADSENSE_SLOT_LISTING_DETAIL=""
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=""
